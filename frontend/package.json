{
  "name": "planner",
  "version": "2.60.0",
  "private": true,
  "description": "HeySpace front-end",
  "homepage": "https://timecamp.com/planner",
  "bugs": {
    "url": "https://github.com/timecamp/timecamp-v3-frontend/issues",
    "email": "dev+tc3febugs@timecamp.com"
  },
  "license": "UNLICENSED",
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "yarn build_types && cross-env NODE_OPTIONS=--max_old_space_size=4096 NODE_ENV=production STORYBOOK_DEVICE=browser -max-old-space-size=4096 webpack --config webpack.config.js",
    "build_types": "rimraf ./dist/ && rimraf ./dist/ && tsc",
    "release": "gh-release",
    "deploy": "bash ./tools/deploy.sh frontend",
    "deploy:staging": "bash ./tools/deploy.sh frontend-staging",
    "tunnel": "bash ./tools/run_tunnels.sh",
    "generate_translations": "yarn build_types && bash ./tools/generate_translations.sh",
    "preinstall": "bash ./tools/install.sh",
    "postinstall": "rimraf node_modules/enzyme-adapter-utils/.babelrc && rimraf node_modules/enzyme-adapter-utils/node_modules",
    "lint": "eslint --ext .ts,.tsx ./app",
    "nibble": "eslint-nibble ./app",
    "run_bundle_stats_server": "cross-env NODE_ENV=production RUN_STATS_SERVER=yes STORYBOOK_DEVICE=browser yarn build",
    "start": "cross-env NODE_ENV=development STORYBOOK_DEVICE=browser node -max-old-space-size=4096 tools/server",
    "start_perf": "cross-env STORYBOOK_DEVICE=browser DEBUG_PERF=true yarn start",
    "start_prod": "yarn build && cross-env NODE_ENV=production STORYBOOK_DEVICE=browser nodemon node tools/server",
    "test": "cross-env STORYBOOK_DEVICE=browser yarn jest",
    "storybook": "cross-env STORYBOOK_DEVICE=browser start-storybook -p 6006",
    "build-storybook": "cross-env STORYBOOK_DEVICE=browser build-storybook",
    "nodemon-start": "nodemon node tools/server"
  },
