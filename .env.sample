NODE_ENV=development
PORT=3001
FEED_PORT=3003
FRONTEND_BASE_URL=http://localhost:3002

# JWT
JWT_SECRET=your-local-secret

# File storage (MinIO)
FILE_STORAGE_ENDPOINT=minio:9000
FILE_STORAGE_REGION=us-east-1
FILE_STORAGE_BUCKET=planner-files
FILE_STORAGE_REQUEST_EXPIRY=180
FILE_STORAGE_ACCEPTABLE_RESIZE_SIZES=20,95,360
FILE_STORAGE_ACCESS_KEY_ID=your-minio-access-key
FILE_STORAGE_SECRET_ACCESS_KEY=your-minio-secret
FILE_STORAGE_SCHEME=http
FILE_STORAGE_USE_PATH_STYLE=true

# Email (Mailpit)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USER=
MAIL_PASSWORD=

# Analytics
AMPLITUDE_TOKEN=

# RabbitMQ
RABBITMQ_USERNAME=heyspace
RABBITMQ_PASSWORD=heyspace

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

DB_USER=heyspace
DB_PASSWORD=heyspace
DB_NAME=heyspace

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

MINIO_ROOT_USER=heyspace
MINIO_ROOT_PASSWORD=heyspace
# Firebase Cloud Messaging (FCM)
FCM_API_KEY=
